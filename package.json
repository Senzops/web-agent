{
  "name": "@senzops/web",
  "version": "1.4.0",
  "description": "Senzor Web Analytics and RUM SDK",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "browser": "dist/index.global.js",
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm,iife --dts --clean --minify"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public"
  }
}
